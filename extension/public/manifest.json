{
  "manifest_version": 3,
  "name": "TunnelDeck",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "description": "从 Chrome 侧边栏安全管理本机 TunnelDeck SSH 隧道。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "sidePanel"
  ],
  "action": {
    "default_title": "打开 TunnelDeck",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
